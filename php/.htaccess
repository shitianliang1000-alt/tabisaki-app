# 旅さき — PHP 版（InfinityFree などの Apache のサーバー）の設定。
DirectoryIndex index.php index.html
Options -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType application/javascript .js .mjs
# 無い URL には、エリアの一覧などへの道があるページを出します（状態は 404 のまま）。
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # 2026-11-24: ブラウザで使う Web 版（/app・/index.html・前のトップ /landing）はやめました。
  # 旧リンクはトップへ移します。サーバーに前の app.php・index.html が残っていても開きません。
  RewriteRule ^(app|landing)/?$ / [R=301,L]
  RewriteRule ^(index\.html|app\.php|landing\.php)$ / [R=301,L]
  # 前の紹介のページ（/about）は、トップ（index.php）にまとめました。
  # （「./」と書くと、Apache がサーバーの中の置き場の道を付けてしまいます。）
  RewriteRule ^about/?$ / [R=301,L]
  # 拡張子なしの URL（/tour・/ssh・/mobile・/api）。
  RewriteRule ^tour/?$ / [R=301,L]
  RewriteRule ^(ssh|mobile|api)/?$ $1.html [L]
  # PHP の部品と、組み立てたデータの元は、直には見せません。
  RewriteRule ^inc(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(self)"
  # キャッシュは種類ごとに分けます。
  #  ・画面と部品（HTML・PHP・js/・css/・データ・Service Worker）は、毎回「変わったか」を
  #    確かめます（no-cache。変わっていなければ 304 で中身は送りません）。js/ の部品は
  #    名前に版が付いていないので、古いものと新しいものが混ざると画面が動きません。
  #  ・絵と字（png・svg・woff2）は、下の mod_expires で数日〜30日持ちます。
  <FilesMatch "\.(html|php|js|mjs|css|json|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
