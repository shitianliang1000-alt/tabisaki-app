# 旅さき — PHP 版（InfinityFree などの Apache のサーバー）の設定。
DirectoryIndex index.php index.html
Options -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType application/javascript .js .mjs

<IfModule mod_rewrite.c>
  RewriteEngine On
  # 紹介のページは /about で開けます（about.php）。
  RewriteRule ^about/?$ about.php [L]
  # PHP の部品と、組み立てたデータの元は、直には見せません。
  RewriteRule ^inc(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  # 古い版の画面が残り続けないように、Service Worker は毎回確かめます。
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
