# 旅さき — PHP 版（InfinityFree などの Apache のサーバー）の設定。
DirectoryIndex index.php index.html
Options -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType application/javascript .js .mjs
# 無い URL には、エリアの一覧などへの道があるページを出します（状態は 404 のまま）。
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # /app/ のままだと、画面の部品（css/・js/ への相対の道）が /app/css/… を探して
  # 見つからず、画面が崩れます。/app へ移ってもらいます（?q= などはそのまま）。
  RewriteRule ^app/$ /app [R=301,L,QSA]
  # チャットの画面は /app で開けます（app.php）。?q= などはそのまま渡します。
  RewriteRule ^app$ app.php [L,QSA]
  # /index.html もチャットの画面です（ホーム画面に置いたアプリと、エリアのページの
  # 「旅程をつくる」が開く場所）。静的なままだと、挨拶が時刻に合わず、canonical も
  # トップ（/）を指してしまうので、/app と同じく app.php が返します。
  RewriteRule ^index\.html$ app.php [L,QSA]
  # 前の紹介のページ（/about）は、トップ（index.php）にまとめました。
  # （「./」と書くと、Apache がサーバーの中の置き場の道を付けてしまいます。）
  RewriteRule ^about/?$ / [R=301,L]
  # PHP の部品と、組み立てたデータの元は、直には見せません。
  RewriteRule ^inc(/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(self)"
  # キャッシュは種類ごとに分けます。
  #  ・画面と部品（HTML・PHP・js/・css/・データ・Service Worker）は、毎回「変わったか」を
  #    確かめます（no-cache。変わっていなければ 304 で中身は送りません）。js/ の部品は
  #    名前に版が付いていないので、古いものと新しいものが混ざると画面が動きません。
  #  ・トップの部品（assets/landing.*）は ?v=版 を付けて読むので、長く持ってかまいません。
  #  ・絵と字（png・svg・woff2）は、下の mod_expires で数日〜30日持ちます。
  <FilesMatch "\.(html|php|js|mjs|css|json|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^landing\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
