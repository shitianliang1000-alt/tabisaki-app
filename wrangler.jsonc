// 旅さき — Cloudflare Worker の設定。
//
// **このファイルはリポジトリの一番上に置きます。** Cloudflare の
// Workers Builds は、つないだリポジトリの一番上で
// `npx wrangler versions upload` を走らせます。設定が server/ の中に
// あると、そこには何も無いので、毎回こう言って止まります。
//
//     ✘ [ERROR] Missing entry-point to Worker script or to assets directory
//
// 名前は、実際に動いている Worker に合わせています
// （packages/core/src/config.js の PROXY_URL が指している先です）。ここを変えると、
// 別の Worker に上がって、アプリからは前のままに見えます。
//
// キーは secret に入れます。このファイルには書かないでください
// （リポジトリに入ります）。
//
//     npx wrangler secret put GEMINI_API_KEY
//     npx wrangler secret put MAPS_API_KEY
//     npx wrangler deploy
{
  "name": "tabisaki-github-io",
  "main": "server/worker.js",
  "compatibility_date": "2026-01-01",

  // --- サイトと管理画面（2026-10-22 から、GitHub Pages ではなくここで配ります） ---
  // 公開するファイルは、デプロイのたびに tools/build_worker.sh が .site/ に
  // 組み立てます（下の build。Workers Builds の `wrangler versions upload`
  // でも、手元の `wrangler deploy` でも先に走ります）。
  //
  //   .site/            … サイト（tools/build_site.sh と同じもの）
  //   .site/__admin/    … 管理画面（admin/）。**直には配りません。**
  //   .site/__site/     … トップのひな形（php/inc/landing.html と同じもの）
  //   .site/assets/     … トップの CSS・JS（php/assets/ と同じもの）
  //   .site/data/       … トップが読むエリアのデータ（tools/build_php_data.mjs）
  //
  // トップ（/）とチャットの画面（/app・/index.html）は、開いたときに Worker が
  // 作ります（server/landing.js。PHP 版の index.php・app.php と同じ中身）。
  //
  // admin/ には認証が無いので、/__admin/ と /admin・/private/ は必ず
  // Worker を先に通します（run_worker_first）。Worker は合言葉
  // （secret ADMIN_PASSWORD）を確かめてから /private/admin/ で見せます
  // （server/admin.js）。合言葉を入れていなければ 404 のままです。
  //
  //     npx wrangler secret put ADMIN_PASSWORD
  //
  // それ以外のファイル（js/・kb/・areas/…）は、Worker を通さずに
  // Cloudflare がそのまま返します（無料枠の回数を使いません）。
  // --- 独自ドメイン（Custom Domain） ---------------------------------------
  // 検索エンジンや SNS のリンクカードの取りに来るもの（Bingbot・X・LINE…）は、
  // InfinityFree（tabisaki.site.je）では JavaScript の確認画面に止められます。
  // Cloudflare に自分のドメインを置き、この Worker に直につなぐと止まりません。
  //
  // **site.je は InfinityFree の共用ドメインなので、ここには書けません**
  // （Cloudflare に登録できるのは、自分で持っているドメインだけです）。
  // 自分のドメインを Cloudflare に足したら、次の // を外して名前を入れます。
  // 書いたドメインがアカウントに無いと、デプロイが失敗します。
  //
  // "routes": [
  //   { "pattern": "example.jp", "custom_domain": true },
  //   { "pattern": "www.example.jp", "custom_domain": true }
  // ],
  // あわせて server/landing.js・php/inc/site.php の SITE_ORIGIN と
  // tools/build_area_pages.mjs の DEFAULT_BASE を同じアドレスにします
  // （tests/canonical.test.js が揃っているかを見ます）。

  "build": {
    "command": "sh tools/build_worker.sh .site"
  },
  "assets": {
    "directory": "./.site",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/app", "/app/", "/__site/*",
                         "/__admin/*", "/admin", "/admin/*", "/private", "/private/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  // --- Workers AI ------------------------------------------------------
  // AIをこのWorkerの中で動かします。**Googleのキーは要りません。**
  // packages/core/src/config.js の MODEL_PROVIDER を "cloudflare" にすると、こちらを
  // 使います。料金は Cloudflare のアカウント側（無料枠あり）です。
  "ai": { "binding": "AI" },

  // --- レート制限（Durable Object） -----------------------------------
  // KV では数えられません。同時に来た2本が同じ値を読み、同じ値を書くため、
  // 「20回まで」が「束ねて投げれば何回でも」になります。従量課金のAPIを
  // 後ろに置いている以上、ここは正確でなければ意味がありません。
  //
  // Durable Object は、1つのIPにつき1つの実体が1本ずつ処理します。
  "durable_objects": {
    "bindings": [
      { "name": "RATE", "class_name": "RateLimiter" },
      // 管理画面のための件数・設定・変更待ち（server/stats.js）。
      // Durable Object なので、ダッシュボードで有効にする作業は要りません。
      { "name": "STATS", "class_name": "Stats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["Stats"] }
  ]

  // --- 使われかたの件数（Workers Analytics Engine） ---------------------
  // 「旅程ができた」「組めなかった（圏外で）」のような出来事を、件数だけ
  // 数えます（js/metrics.js・server/worker.js の metrics）。入力した文・
  // 地名・IP は書きません。無料枠の中で動きます。
  //
  // **アカウントで Analytics Engine を有効にするまで、ここは外しておきます。**
  // 有効にしていないアカウントでバインディングを書くと、Worker のデプロイ
  // そのものが失敗し、ほかの変更も届かなくなります（#81 のあとがそうでした）。
  // 外してあるあいだ、/metrics は受け取って 204 を返すだけで、何も残しません。
  //
  // 使うとき: ダッシュボードの Workers & Pages → Analytics Engine → Set up を
  // 一度押してから、上の行の末尾に「,」を足し、次の3行の // を外します。
  // "analytics_engine_datasets": [
  //   { "binding": "METRICS", "dataset": "tabisaki_metrics" }
  // ]

  // --- 保険としての、Cloudflare 側のレート制限 -------------------------
  // 上のものは「このWorkerに届いてから」効きます。届く前に落としたいなら、
  // ダッシュボードの Security → WAF → Rate limiting rules で、
  // このWorkerのパスに対する上限も設定してください。二重にかけて損は
  // ありません。
}
