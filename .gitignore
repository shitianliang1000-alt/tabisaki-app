# Python
__pycache__/
*.py[cod]
.venv/

# Node
node_modules
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ローカルで生成するもの
/tmp/
/dist/
/.site/
/bench-out/

# ウィキペディアから落とした素データ。**収録そのものではありません。**
# tools/fetch_wikipedia_lists.py が落とし、tools/import_wikipedia_lists.py が
# data/spots-wp*.json に直します。収録に入るのは直したあとのほうです。
# 素データは30MBを超え、走らせ直せばまた作れます。
/data/wikipedia/

# OpenStreetMap の配布ファイル（tools/fetch_osm_extracts.py が落とす）。
# 数GBあり、落とし直せば同じものが手に入ります。収録に入るのは、
# tools/import_osm_tourlist.py が直したあとのほうだけです。
/data/osm/

# Overture Maps の日本の施設データ（tools/fetch_overture_places.py が取り出す）。
# 数百MBあり、取り直せば同じものが手に入ります。収録に入るのは、
# 突き合わせたあとのほうだけです。
/data/overture/
/.php-site/
/tabisaki-php.zip
/.env.deploy
# tabisaki kb extract / kb index が作るもの（作り直せます）
/.tabisaki/

# 国土数値情報の非商用データ（P12・P27・P11）。公開しません（docs/kokudo-licenses.md）。
# tools/split_noncommercial.mjs が kb/ から移します。
/kb-private/
# 上の kb-private/ を R2 に入れる形に詰め直したもの（tools/upload_private_kb.mjs）。
# これも非商用の元データです。公開しません（docs/private-kb.md）。
/.private-kb/

# JR の駅の記事から落とした情報欄（tools/fetch_rail_stations.py）。走らせ直せば
# また作れます。路線網に直したもの（packages/core/rail/jr-graph.json）のほうを入れます。
/data/rail-raw/
# OpenTripPlanner の時刻表・地図・組み立てた経路網（tools/otp_fetch.py で作り直せます。Issue #429）
/data/otp/
# 最長片道切符のソルバー（Rust）を組み立てたもの。入れるのは WebAssembly にした
# packages/core/rail/longest_ticket.wasm だけです。
/solver/longest-ticket/target/

# 学習の結果（training/。重み・GGUF は大きいので Hugging Face Hub に置く）
/runs/
