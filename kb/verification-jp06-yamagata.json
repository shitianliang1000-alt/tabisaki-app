ikiTitle":"霞城セントラル","checkedAt":"2026-11-03","coordDistanceM":0},"wp-a667c1acc2":{"status":"verified","wikiTitle":"高瀬山古墳","checkedAt":"2026-11-03","coordDistanceM":0},"wp-d3a36535c4":{"status":"verified","wikiTitle":"鶴岡カトリック教会天主堂","checkedAt":"2026-11-03","coordDistanceM":0},"wp-558a366d06":{"status":"verified","wikiTitle":"黒川能","checkedAt":"2026-11-03","coordDistanceM":0},"wp-143763ccfd":{"status":"verified","wikiTitle":"黒沢温泉","checkedAt":"2026-11-03","coordDistanceM":1},"tl-ba8b9a36c9":{"status":"verified","wikiTitle":"空気神社","checkedAt":"2026-11-03","coordDistanceM":0},"tl-e23151ebd8":{"status":"verified","wikiTitle":"瓜割石庭公園","checkedAt":"2026-11-03","coordDistanceM":0},"tl-ed5097066e":{"status":"verified","wikiTitle":"百目鬼温泉","checkedAt":"2026-11-03","coordDistanceM":0},"tl-74270321d7":{"status":"verified","wikiTitle":"高館山","checkedAt":"2026-11-03","coordDistanceM":0},"os-91a1bec1ed":{"status":"name_match_low","wikiTitle":"建角身神","checkedAt":"2026-11-03"},"os-6705ce8f72":{"status":"name_match_medium","wikiTitle":"もみの木","checkedAt":"2026-11-03"},"os-996524f39f":{"status":"verified_web","source":"https://meta.ai?place_id=1423149921803590","checkedAt":"2026-11-03","sourceTitle":"耳の神様","note":"東置賜郡高畠町の宗教施設としてプレイス情報に掲載され、座標（38.009064, 140.218957）がスポット座標と約10m以内で一致"},"ov-0966fbd088":{"status":"name_match_low","wikiTitle":"立石寺","checkedAt":"2026-11-03"},"ov-26811c2ec6":{"status":"name_match_low","wikiTitle":"芭蕉塚古墳","checkedAt":"2026-11-03"},"gc-30032a9862":{"status":"name_match_medium","wikiTitle":"延沢銀山遺跡","checkedAt":"2026-11-03"},"gc-a5b122c3bf":{"status":"name_match_medium","wikiTitle":"熊野大社","checkedAt":"2026-11-03"},"gc-13aa5bec3a":{"status":"verified_web","source":"https://www.iide3.net/suibotsurin","checkedAt":"2026-11-03","sourceTitle":"白川湖の水没林｜いいでカヌークラブ — いいでカヌークラブ","note":"飯豊町・白川湖（白川ダム湖）で春の雪解け期のみ現れる水没林。スポット座標は湖上"},"gc-5b14f86d52":{"status":"verified_web","source":"https://www.tsuruokacity.com/spot/7508","checkedAt":"2026-11-03","sourceTitle":"Kushibiki Taranokidai Ski Resort – Tsuruoka City Official Tourism Information Website","note":"実在住所は鶴岡市たらのき代字西野469-1。スポット座標は実位置から約10km北西にずれている（gc-座標誤差）"}}}